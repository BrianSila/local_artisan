{
  "info": {
    "name": "Local Artisan API",
    "description": "End-to-end Postman requests for every registered application endpoint. Run in order. Configure the companion environment and satisfy the README prerequisites first.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Request returned a successful status', function () {",
          "    pm.expect(pm.response.code).to.be.within(200, 299);",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Health and locations",
      "item": [
        {
          "name": "Root",
          "request": { "method": "GET", "url": "{{baseUrl}}/" }
        },
        {
          "name": "Health",
          "request": { "method": "GET", "url": "{{baseUrl}}/health" }
        },
        {
          "name": "List counties",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const counties = pm.response.json();",
                  "pm.test('Counties are returned as an array', function () { pm.expect(counties).to.be.an('array'); });",
                  "const county = counties.find((item) => item.sub_counties && item.sub_counties.length) || counties[0];",
                  "if (county) {",
                  "    pm.environment.set('countyId', county.id);",
                  "    if (county.sub_counties && county.sub_counties.length) pm.environment.set('subCountyId', county.sub_counties[0].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/locations/counties"
          }
        },
        {
          "name": "List subcounties for countyId",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/locations/counties/{{countyId}}/subcounties"
          }
        },
        {
          "name": "List categories (sets categoryId and categorySlug)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const categories = pm.response.json();",
                  "if (categories.length) {",
                  "    pm.environment.set('categoryId', categories[0].id);",
                  "    pm.environment.set('categorySlug', categories[0].slug);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/marketplace/categories"
          }
        }
      ]
    },
    {
      "name": "Accounts",
      "item": [
        {
          "name": "Register customer",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('customerEmail', 'postman.customer.' + Date.now() + '@example.test');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('customerId', pm.response.json().user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Customer\",\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\",\n  \"phone\": \"0712345678\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Login customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.environment.set('customerToken', body.access_token);",
                  "pm.environment.set('customerId', body.user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Update customer profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Customer Updated\",\n  \"phone\": \"0712345678\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/profile"
          }
        },
        {
          "name": "Register artisan",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('artisanEmail', 'postman.artisan.' + Date.now() + '@example.test');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('artisanUserId', pm.response.json().user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Artisan\",\n  \"email\": \"{{artisanEmail}}\",\n  \"password\": \"{{artisanPassword}}\",\n  \"phone\": \"0712345678\",\n  \"role\": \"artisan\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Login artisan",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.environment.set('artisanToken', body.access_token);",
                  "pm.environment.set('artisanUserId', body.user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{artisanEmail}}\",\n  \"password\": \"{{artisanPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Register disposable user for suspension test",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('suspensionEmail', 'postman.suspend.' + Date.now() + '@example.test');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('suspensionUserId', pm.response.json().user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Disposable Suspension Target\",\n  \"email\": \"{{suspensionEmail}}\",\n  \"password\": \"{{spareUserPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Admin login (configure credentials in environment)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('adminToken', pm.response.json().access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "List users (admin)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": "{{baseUrl}}/api/auth/users?page=1&limit=20"
          }
        },
        {
          "name": "Change customer role (admin; sets role to customer)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"role\": \"customer\"\n}" },
            "url": "{{baseUrl}}/api/auth/users/{{customerId}}/role"
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Dashboard stats",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": "{{baseUrl}}/api/admin/dashboard/stats"
          }
        },
        {
          "name": "Suspend disposable user (admin; run near end)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"is_blocked\": true\n}" },
            "url": "{{baseUrl}}/api/admin/users/{{suspensionUserId}}/suspend"
          }
        }
      ]
    },
    {
      "name": "Artisan",
      "item": [
        {
          "name": "Onboard artisan (multipart form)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const profile = pm.response.json().profile;",
                  "pm.environment.set('artisanProfileId', profile.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{artisanToken}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "bio",
                  "value": "Experienced local artisan providing reliable home repairs.",
                  "type": "text"
                },
                { "key": "experience_years", "value": "4", "type": "text" },
                {
                  "key": "primary_phone",
                  "value": "0712345678",
                  "type": "text"
                },
                { "key": "county_id", "value": "{{countyId}}", "type": "text" },
                {
                  "key": "sub_county_id",
                  "value": "{{subCountyId}}",
                  "type": "text"
                },
                {
                  "key": "specific_address",
                  "value": "Central market",
                  "type": "text"
                }
              ]
            },
            "url": "{{baseUrl}}/api/artisan/onboard"
          }
        },
        {
          "name": "Verify artisan (admin; enables public search/contact)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"is_verified\": true\n}" },
            "url": "{{baseUrl}}/api/admin/artisans/{{artisanProfileId}}/verify"
          }
        },
        {
          "name": "Update artisan profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{artisanToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bio\": \"Updated artisan biography with verified experience.\",\n  \"primary_phone\": \"0712345678\",\n  \"specific_address\": \"Central market, Nairobi\"\n}"
            },
            "url": "{{baseUrl}}/api/artisan/profile"
          }
        },
        {
          "name": "Upload or replace artisan profile image (select a file)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('artisanImageUrl', pm.response.json().profile_image_url);"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{artisanToken}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "profile_image", "type": "file", "src": "" }
              ]
            },
            "url": "{{baseUrl}}/api/artisan/profile/image"
          }
        },
        {
          "name": "Fetch uploaded profile image",
          "request": { "method": "GET", "url": "{{artisanImageUrl}}" }
        },
        {
          "name": "Add catalog service",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('serviceId', pm.response.json().service.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{artisanToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category_id\": {{categoryId}},\n  \"title\": \"Home repair\",\n  \"description\": \"General household repair and maintenance work.\",\n  \"price_type\": \"fixed\",\n  \"base_price\": 1500.00\n}"
            },
            "url": "{{baseUrl}}/api/artisan/services"
          }
        }
      ]
    },
    {
      "name": "Marketplace",
      "item": [
        {
          "name": "List categories",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const categories = pm.response.json();",
                  "if (categories.length) {",
                  "    pm.environment.set('categoryId', categories[0].id);",
                  "    pm.environment.set('categorySlug', categories[0].slug);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/marketplace/categories"
          }
        },
        {
          "name": "Search listings",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/marketplace/search?category_slug={{categorySlug}}&county_id={{countyId}}&sub_county_id={{subCountyId}}"
          }
        },
        {
          "name": "Get specific listing",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/marketplace/listings/{{serviceId}}"
          }
        },
        {
          "name": "Get WhatsApp contact link (customer must be logged in)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": "{{baseUrl}}/api/marketplace/listings/{{serviceId}}/whatsapp?message=Hi%20I%20am%20interested%20in%20your%20service"
          }
        }
      ]
    },
    {
      "name": "Bookings and operations",
      "item": [
        {
          "name": "Create booking for review workflow",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('scheduledDate', new Date(Date.now() + 86400000 * 2).toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('bookingId', pm.response.json().booking.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"artisan_id\": \"{{artisanProfileId}}\",\n  \"service_id\": \"{{serviceId}}\",\n  \"scheduled_date\": \"{{scheduledDate}}\",\n  \"notes\": \"Postman booking test\"\n}"
            },
            "url": "{{baseUrl}}/api/bookings"
          }
        },
        {
          "name": "Initiate mock M-Pesa checkout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_number\": \"0712345678\"\n}"
            },
            "url": "{{baseUrl}}/api/operations/checkout/{{bookingId}}"
          }
        },
        {
          "name": "Customer booking history",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": "{{baseUrl}}/api/bookings/history?page=1&limit=20"
          }
        },
        {
          "name": "Artisan booking history",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{artisanToken}}" }
            ],
            "url": "{{baseUrl}}/api/bookings/history?page=1&limit=20"
          }
        },
        {
          "name": "Artisan accepts booking",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{artisanToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"accepted\"\n}"
            },
            "url": "{{baseUrl}}/api/bookings/{{bookingId}}/status"
          }
        },
        {
          "name": "Artisan dispatches booking",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{artisanToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"dispatched\"\n}"
            },
            "url": "{{baseUrl}}/api/bookings/{{bookingId}}/status"
          }
        },
        {
          "name": "Artisan completes booking",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{artisanToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"completed\"\n}"
            },
            "url": "{{baseUrl}}/api/bookings/{{bookingId}}/status"
          }
        },
        {
          "name": "Review completed booking",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 5,\n  \"comment\": \"Good work and clear communication.\"\n}"
            },
            "url": "{{baseUrl}}/api/operations/bookings/{{bookingId}}/review"
          }
        },
        {
          "name": "Create booking for dispute workflow",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('scheduledDate', new Date(Date.now() + 86400000 * 3).toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('disputeBookingId', pm.response.json().booking.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"artisan_id\": \"{{artisanProfileId}}\",\n  \"service_id\": \"{{serviceId}}\",\n  \"scheduled_date\": \"{{scheduledDate}}\",\n  \"notes\": \"Postman dispute test\"\n}"
            },
            "url": "{{baseUrl}}/api/bookings"
          }
        },
        {
          "name": "Initiate mock checkout for dispute booking",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_number\": \"0712345678\"\n}"
            },
            "url": "{{baseUrl}}/api/operations/checkout/{{disputeBookingId}}"
          }
        },
        {
          "name": "File dispute",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"The agreed service was not completed as described.\"\n}"
            },
            "url": "{{baseUrl}}/api/operations/bookings/{{disputeBookingId}}/dispute"
          }
        }
      ]
    },
    {
      "name": "Admin dispute resolution",
      "item": [
        {
          "name": "List open disputes",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const items = pm.response.json().items || [];",
                  "const match = items.find((item) => item.booking_id === pm.environment.get('disputeBookingId'));",
                  "if (match) pm.environment.set('disputeId', match.id);",
                  "pm.test('Dispute for the test booking is present', function () { pm.expect(match).to.exist; });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": "{{baseUrl}}/api/admin/disputes?page=1&limit=100"
          }
        },
        {
          "name": "Resolve dispute",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resolution_status\": \"released_to_fundi\",\n  \"resolution_details\": \"Work reviewed and funds released to the artisan.\"\n}"
            },
            "url": "{{baseUrl}}/api/admin/disputes/{{disputeId}}/resolve"
          }
        }
      ]
    },
    {
      "name": "Cleanup (destructive; run last)",
      "item": [
        {
          "name": "Delete catalog service",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{artisanToken}}" }
            ],
            "url": "{{baseUrl}}/api/artisan/services/{{serviceId}}"
          }
        },
        {
          "name": "Change customer password",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('customerPassword', pm.environment.get('customerNewPassword'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"old_password\": \"{{customerPassword}}\",\n  \"new_password\": \"{{customerNewPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/change-password"
          }
        },
        {
          "name": "Login customer with changed password",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('customerToken', pm.response.json().access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Deactivate customer (last; blocks account)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": "{{baseUrl}}/api/auth/deactivate"
          }
        }
      ]
    }
  ]
}
